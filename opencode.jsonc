{
  "$schema": "https://opencode.ai/config.json",
  "model": "parasail/parasail-glm-53",
  "providers": {
    "parasail": {
      "name": "Parasail",
      "env": ["PARASAIL_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.parasail.io/v1"
      },
      "models": {
        "parasail-glm-53": {
          "name": "GLM 5.3"
        }
      }
    }
  }
}

